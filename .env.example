# Where contact-form leads go. Set one delivery (SMTP or Resend), optionally a webhook too.
# With none set, leads are logged to the server console and the visitor gets a pre-filled mail draft.

# Inbox(es) that receive each lead, comma separated. Defaults to rupam@3rdivisuals.com.
LEAD_TO_EMAIL=
# Sender shown on the email. For SMTP it should be the mailbox you log in with (Gmail rewrites it anyway).
LEAD_FROM_EMAIL=

# Option A: send from an existing mailbox over SMTP. Gmail / Google Workspace: smtp.gmail.com, port 587,
# your address as the user and a 16-character App Password (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Option B: send through https://resend.com (verify the 3rdivisuals.com domain there first).
RESEND_API_KEY=

# Optional: also POST every lead as JSON to a webhook (Zapier, Make, n8n, Google Sheets, your CRM).
LEAD_WEBHOOK_URL=

# Static export only (no API route): post the form straight to Formspree / Web3Forms / your own endpoint.
NEXT_PUBLIC_LEAD_ENDPOINT=
